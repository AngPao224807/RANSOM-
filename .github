name: Build APK

on:
  push:
    branches: [ main ]

jobs:
  build:
    runs-on: ubuntu-22.04

    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: install
        run: |
          sudo apt-get update -qq
          sudo apt-get install -y python3-pip build-essential git zlib1g-dev libssl-dev libffi-dev wget automake libtool unzip ccache
          pip3 install --upgrade pip
          pip3 install buildozer==1.5.0 cython==0.29.36

      - name: build pass 1
        run: buildozer android debug || true

      - name: accept license
        run: |
          SDK="$HOME/.buildozer/android/platform/android-sdk"
          mkdir -p "$SDK/licenses"
          printf '24333f8a63b6825ea9c5514f83c2829b004d1fee\nd56f5187479451eabf01fb78af6dfcb131a6481e\n' > "$SDK/licenses/android-sdk-license"
          printf '84831b9409646a918e30573bab4c9c91346d8abd\n' > "$SDK/licenses/android-sdk-preview-license"

      - name: build pass 2
        run: buildozer android debug

      - name: upload
        uses: actions/upload-artifact@v4
        with:
          name: ransom-apk
          path: bin/*.apk
          if-no-files-found: error
